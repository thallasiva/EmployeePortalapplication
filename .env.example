# ─── Sentry (Error tracking + Performance monitoring) ─────────────────────────
# 1. Sign up free at https://sentry.io → Create Project → React
# 2. Copy the DSN from Project Settings → Client Keys
# 3. Rename this file to .env.local and paste your DSN below
REACT_APP_SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# App version shown in Sentry releases (optional)
REACT_APP_VERSION=1.0.0

# Backend API URL
REACT_APP_API_URL=https://backend.natsoft.io/api

# ─── Production build security ─────────────────────────────────────────────────
# Disable source maps in production builds so JavaScript internals are not
# exposed to the browser. Set to true only during local debugging.
GENERATE_SOURCEMAP=false

# ─── Backend environment variables (add to backend/.env) ───────────────────────

# Salary Encryption — AES-256-GCM key (REQUIRED for salary encryption)
# Generate a fresh key with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real key to version control.
SALARY_ENCRYPTION_KEY=replace_with_64_char_hex_string

# JWT secrets — replace with strong random values in production
JWT_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
