# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrms_db
DB_CONNECTION_LIMIT=10

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Salary Encryption (AES-256-GCM) ─────────────────────────────────────────
# REQUIRED — all salary/payslip fields in the DB are encrypted with this key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value to version control.
SALARY_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HRMS <no-reply@hrms.local>

# ─── Microsoft Teams (Azure Graph API) ───────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TEAMS_ORGANIZER_USER_ID=

# ─── Google Meet (Google Calendar API — OAuth2) ───────────────────────────────
# 1. Create OAuth2 credentials in Google Cloud Console (Calendar API scope)
# 2. Run the one-time auth flow to get a refresh token
# 3. Paste the values below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ORGANIZER_EMAIL=recruiter@yourcompany.com

# ─── Zoom (Server-to-Server OAuth) ───────────────────────────────────────────
# Create a Server-to-Server OAuth app at marketplace.zoom.us
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=recruiter@yourcompany.com

# ─── OpenAI (AI Interview & Resume Parser) ────────────────────────────────────
# Used for: AI resume parsing (gpt-4o-mini) + AI interview question generation & evaluation
# Leave blank to use regex fallback for resume parser and generic questions for AI interview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Frontend URL (for AI Interview invite links) ─────────────────────────────
FRONTEND_URL=http://localhost:3000
