# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hrms_db
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Email (SMTP) - used to send generated payslips to employees
# For Gmail: host=smtp.gmail.com, port=587, secure=false, user=<your gmail>, pass=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HRMS <no-reply@hrms.local>
