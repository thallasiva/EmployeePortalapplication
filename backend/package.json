{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "HRMS backend REST API (Node.js, Express, MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/database/runSql.js schema.sql procedures.sql seed.sql",
    "db:migrate": "node src/database/runSql.js migration_002_employee_extended_fields.sql",
    "db:migrate:003": "node src/database/runSql.js migration_003_fix_leave_balance_init.sql",
    "db:migrate:004": "node src/database/runSql.js migration_004_default_users_and_balances.sql",
    "db:migrate:005": "node src/database/runSql.js migration_005_sample_salary_structure.sql",
    "db:migrate:006": "node src/database/runSql.js migration_006_salary_structures_all_employees.sql"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.2",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
